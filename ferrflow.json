{
  "$schema": "https://ferrflow.com/schema/ferrflow.json",
  "workspace": {
    "versioning": "semver",
    "tagTemplate": "{name}@v{version}",
    "recoverMissedReleases": true,
    "deferPublish": true,
    "registries": {
      "kellnr": {
        "tokenEnv": "CARGO_REGISTRIES_KELLNR_TOKEN"
      }
    }
  },
  "package": [
    {
      "name": "ferrlabs-errors",
      "path": "crates/errors",
      "changelog": "crates/errors/CHANGELOG.md",
      "versionedFiles": [
        {
          "path": "crates/errors/Cargo.toml",
          "format": "toml"
        },
        {
          "path": "Cargo.toml",
          "format": "txt",
          "selector": "(?m)^ferrlabs-errors = .*version = \"([^\"]+)\""
        }
      ],
      "sharedPaths": [
        "Cargo.toml"
      ],
      "publishers": [
        {
          "kind": "cargo",
          "registry": "kellnr",
          "noVerify": true
        }
      ]
    },
    {
      "name": "ferrlabs-types",
      "path": "crates/types",
      "changelog": "crates/types/CHANGELOG.md",
      "versionedFiles": [
        {
          "path": "crates/types/Cargo.toml",
          "format": "toml"
        },
        {
          "path": "Cargo.toml",
          "format": "txt",
          "selector": "(?m)^ferrlabs-types = .*version = \"([^\"]+)\""
        }
      ],
      "dependsOn": [
        "ferrlabs-errors"
      ],
      "publishers": [
        {
          "kind": "cargo",
          "registry": "kellnr",
          "noVerify": true
        }
      ]
    },
